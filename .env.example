APP_NAME=Discord_IVAO_Auth
APP_ENV=production
APP_KEY= # generated by php artisan key:generate (keep the existing key in production: it decrypts the saved role rules)
APP_DEBUG=false
APP_URL= # The URL of your website, e.g. https://discord.br.ivao.aero

LANGUAGE=pt-Br # en, es or pt-Br
DEFAULT_TITLE=IVAO_BR_Discord_Auth_System # underscores are rendered as spaces

LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_DISCORD_WEBHOOK_URL= # optional: Discord webhook that receives the logs

DB_CONNECTION=mysql
DB_HOST=db.division.ivao.aero # It can be 127.0.0.1 if you are using a local database
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=10
CACHE_STORE=file
QUEUE_CONNECTION=sync

# IVAO SSO application (redirect URI: APP_URL/ivao/callback)
IVAO_CLIENT_ID=
IVAO_CLIENT_SECRET=
IVAO_SCOPES="profile configuration"

# Discord application (redirect URI: APP_URL/discord/callback) and bot
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_PUBLIC_KEY= # Developer Portal > General Information, required for /sync

ADMIN_VIDS= # VIDs allowed to use /admin, separated by ":"
MIN_HOURS=5 # members need more than this many pilot + ATC hours

SYNC_TIME=04:00 # daily automatic sync, America/Sao_Paulo
SYNC_DELAY_MS=250 # pause between batches during the sync
SYNC_BATCH_SIZE=10 # members asked about at once, in parallel
SYNC_COOLDOWN_MINUTES=5 # minimum interval between /sync commands of a member
SYNC_MAX_REMOVALS=50 # a run that removes roles from more members than this stops
